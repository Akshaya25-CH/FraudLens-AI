# ==============================================================================
# FraudLens AI — Root .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
.env/
backend/venv/
backend/env/
backend/.venv/

# Python Bytecode, Caches & Test Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Package Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Production Build Outputs
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Temporary Workspace & Scratch Files
scratch/
*.tmp
*.temp
logs/
*.log

# Operating System & IDE Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Public release: preserve licensing notice, exclude model binaries and experiment artifacts
!models/
!models/NOTICE.md
!datasets/
!datasets/**
models/*.joblib
models/**/*.joblib
models/experiments/
models/model_checksums.json
